{
  "name": "gastometro-rolante",
  "version": "0.1.1",
  "private": true,
  "type": "module",
  "description": "Quanto a Prefeitura de Rolante-RS gasta e em quê, com dados do Portal da Transparência. Site independente.",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "site"
  ],
  "scripts": {
    "coletar": "node coletor/src/coletar.ts",
